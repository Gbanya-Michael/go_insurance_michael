<%# 404 Not Found Error Page %>
<div class="max-w-4xl mx-auto px-4 py-8 md:py-16">
  <div class="text-center">
    <h1 class="text-6xl md:text-8xl font-bold text-gray-300 mb-4">404</h1>
    <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-4">Page Not Found</h2>
    <p class="text-gray-600 mb-8 max-w-md mx-auto">
      The page you're looking for doesn't exist. It may have been moved or the URL might be incorrect.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to "Go to Home", root_path, class: "px-6 py-3 bg-primary hover:bg-primary-dark text-white font-semibold rounded-md transition-colors" %>
      <%= link_to "Create New Quote", new_quote_path, class: "px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold rounded-md transition-colors" %>
    </div>
  </div>
</div>
